{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CajaGo",
  "mainBinaryName": "CajaGo",
  "version": "1.13.28",
  "identifier": "com.cajago.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CajaGo",
        "url": "index.html",
        "userAgent": "CajaGo-Desktop/1.0",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "backgroundColor": "#090c11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mrpenblsmooeqzegtcqp.supabase.co/storage/v1/object/public/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERUFGODA1RDUxODgzRDkKUldUWmd4alZCZmpxL1ZlME51SXcvVS9QczFxb1kxeWlLanQzNFA0RHB1cFpSRGdZdEprU1NSZlcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
